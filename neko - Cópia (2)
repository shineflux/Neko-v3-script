                stopAllManualTracks()
                isManualEmotePlaying = true
                local track = loadedManualEmotes[data.Name]
                if track then 
                    track:Play(0.3) 
                    local conn; conn = track.Stopped:Connect(function()
                        isManualEmotePlaying = false
                        if hum.MoveDirection.Magnitude < 0.1 then startIdleSequence() end
                        conn:Disconnect()
                    end)
                end
            end
        end
    end)
end

-- Variáveis para o sistema de Interação
local currentInteractTrack = nil
local interactLoop = nil

-- Create Interact Buttons in Scroll
for _, data in ipairs(interactData) do
    local btn = Instance.new("TextButton")
    btn.Name = data.Name
    btn.Parent = interactScroll
    btn.Size = UDim2.new(1, -5, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = data.Name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    
    btn.MouseButton1Click:Connect(function()
        if data.AnimID then
            if player.Backpack:FindFirstChild(data.Name) or (player.Character and player.Character:FindFirstChild(data.Name)) then
                return
            end

            local tool = Instance.new("Tool")
            tool.Name = data.Name
            tool.RequiresHandle = false
            tool.Parent = player.Backpack

            local mouse = player:GetMouse()
            local clickConn

            -- Configurações específicas de cada ação
            local speed = data.Speed or 15
            local baseX = data.BaseX or 0
            local baseZ = data.BaseZ or -1.3
            local amplitude = data.Amplitude or 0.5
            local rotAngle = data.Rotation or 0

            tool.Equipped:Connect(function()
                clickConn = tool.Activated:Connect(function()
                    local target = mouse.Target
                    if target and target.Parent and target.Parent:FindFirstChild("Humanoid") and target.Parent ~= player.Character then
                        local targetChar = target.Parent
                        local myChar = player.Character
                        
                        if myChar and myChar:FindFirstChild("HumanoidRootPart") and targetChar:FindFirstChild("HumanoidRootPart") then
                            
                            if interactLoop then interactLoop:Disconnect(); interactLoop = nil end
                            if currentInteractTrack then currentInteractTrack:Stop() end
                            
                            local animator = myChar.Humanoid:FindFirstChild("Animator")
                            if animator then
                                local anim = Instance.new("Animation")
                                anim.AnimationId = getTrueAnimationId(data.AnimID)
                                currentInteractTrack = animator:LoadAnimation(anim)
                                currentInteractTrack.Priority = Enum.AnimationPriority.Action4
                                currentInteractTrack:Play()
                            end

                            interactLoop = RunService.Heartbeat:Connect(function()
                                if not myChar or not targetChar or not myChar:FindFirstChild("HumanoidRootPart") or not targetChar:FindFirstChild("HumanoidRootPart") then
                                    if interactLoop then interactLoop:Disconnect(); interactLoop = nil end
                                    return
                                end

                                -- Movimento de vaivém suave
                                local moveOffset = math.sin(tick() * speed) * amplitude
                                
                                -- Posicionamento escorado e posicionado corretamente
                                myChar.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame * CFrame.new(baseX, 0, baseZ + moveOffset) * CFrame.Angles(0, math.rad(rotAngle), 0)
                            end)
                        end
                    end
                end)
            end)

            tool.Unequipped:Connect(function()
                if clickConn then clickConn:Disconnect() end
                if interactLoop then 
                    interactLoop:Disconnect()
                    interactLoop = nil
                end
                if currentInteractTrack then 
                    currentInteractTrack:Stop()
                    currentInteractTrack = nil
                end
            end)
        else
            print("Clicou em: " .. data.Name)
        end
    end)
end

